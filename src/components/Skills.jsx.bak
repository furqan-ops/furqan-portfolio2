import Section from "./Section";
import { skills } from "../data/portfolio";
import { motion } from "framer-motion";

export default function Skills() {
  return (
    <Section id="skills" cmd="cat stack.yml" path="~/stack">
      <h2 className="text-3xl md:text-4xl text-white font-bold mb-3">
        What I work with
      </h2>
      <p className="text-base md:text-lg text-muted mb-10">
        Tools I reach for day to day.
      </p>
      <div className="grid md:grid-cols-2 gap-8">
        {Object.entries(skills).map(([group, items], i) => (
          <motion.div
            key={group}
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ delay: i * 0.08 }}
          >
            <div className="text-accent text-base md:text-lg font-semibold mb-4">
              {group}
            </div>
            <div className="flex flex-wrap gap-2">
              {items.map((s) => (
                <span
                  key={s}
                  className="px-3 py-1.5 text-sm md:text-base border border-border rounded-full text-text/85 hover:border-accent hover:text-accent transition"
                >
                  {s}
                </span>
              ))}
            </div>
          </motion.div>
        ))}
      </div>
    </Section>
  );
}
