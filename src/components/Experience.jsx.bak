import Section from "./Section";
import { experience } from "../data/portfolio";

export default function Experience() {
  return (
    <Section id="experience" cmd="git log --oneline --career" path="~/career">
      <h2 className="text-3xl md:text-4xl text-white font-bold mb-10">
        Where I've shipped automations
      </h2>
      <div className="space-y-10">
        {experience.map((e) => (
          <div key={e.company} className="border-l-2 border-border pl-6 md:pl-8 relative">
            <div className="absolute -left-[9px] top-2 w-4 h-4 rounded-full bg-accent shadow-[0_0_16px_#7ee787]" />

            <div className="text-sm md:text-base text-muted mb-2">
              {e.period} · {e.location}
            </div>

            <div className="text-lg md:text-xl text-white font-semibold mb-2">
              {e.role} <span className="text-accent">@ {e.company}</span>
            </div>

            {e.summary && (
              <p className="text-base md:text-lg text-text/85 leading-relaxed mb-5">
                {e.summary}
              </p>
            )}

            <ul className="space-y-3 text-base md:text-lg text-text/80 leading-relaxed">
              {e.bullets.map((b, i) => (
                <li key={i} className="before:content-['>'] before:text-accent before:mr-3">
                  {b}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </Section>
  );
}
