import { motion } from "framer-motion";
import { useEffect, useState } from "react";
import { profile } from "../data/portfolio";

function useTypewriter(text, speed = 55) {
  const [out, setOut] = useState("");
  useEffect(() => {
    let i = 0;
    const id = setInterval(() => {
      setOut(text.slice(0, ++i));
      if (i >= text.length) clearInterval(id);
    }, speed);
    return () => clearInterval(id);
  }, [text, speed]);
  return out;
}

const container = {
  hidden: { opacity: 0 },
  show: {
    opacity: 1,
    transition: { staggerChildren: 0.12, delayChildren: 2.2 },
  },
};
const item = {
  hidden: { opacity: 0, y: 20 },
  show: { opacity: 1, y: 0, transition: { duration: 0.5 } },
};

export default function Hero() {
  const typed = useTypewriter(profile.tagline);

  return (
    <motion.section
      variants={container}
      initial="hidden"
      animate="show"
      id="top"
      className="relative z-10 max-w-4xl mx-auto px-6 pt-28 pb-16"
    >
      <motion.div variants={item} className="text-sm md:text-base text-muted mb-6">
        <span className="text-accent">{profile.prompt}</span> · zsh
      </motion.div>

      <motion.h1
        variants={item}
        className="text-4xl md:text-6xl font-bold text-white mb-4"
      >
        {profile.name}
      </motion.h1>

      <motion.p variants={item} className="text-base md:text-lg text-muted mb-8">
        {profile.location} · <span className="text-accent">online</span> · open to remote roles
      </motion.p>

      <motion.div
        variants={item}
        className="text-xl md:text-2xl text-accent2 mb-10 h-8 cursor-blink font-semibold"
      >
        {typed}
      </motion.div>

      <motion.p
        variants={item}
        className="max-w-2xl text-lg md:text-xl text-text/90 leading-relaxed mb-10"
      >
        {profile.blurb}
      </motion.p>

      <motion.div variants={item} className="flex flex-wrap gap-3 text-base">
        <a
          href={`mailto:${profile.email}?subject=Opportunity%20for%20Furqan`}
          className="px-6 py-3 bg-accent/20 border-2 border-accent text-accent rounded hover:bg-accent/30 transition font-bold"
        >
          Email Me →
        </a>
        <a
          href={profile.github}
          target="_blank"
          rel="noreferrer"
          className="px-6 py-3 border border-border rounded hover:border-accent hover:text-accent transition"
        >
          View GitHub
        </a>
      </motion.div>

      <motion.div variants={item} className="mt-16 text-muted text-sm animate-bounce">
        scroll
      </motion.div>
    </motion.section>
  );
}
